          "name": "Set sample expiration",
          "request": {
            "name": "Set sample expiration",
            "description": {
              "content": "Set a sample to expire on a specific date, set it to never expire, or clear any custom expiration and follow the org default. Caller must be the sample's creator, an org owner/admin, or a Strand admin.",
